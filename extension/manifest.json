{
  "manifest_version": 3,
  "name": "YKD AI Translator for 1688",
  "version": "1.2.0",
  "description": "Translate 1688.com into English using the local YKD AI app. Runs offline on your own machine — no cloud, no API key.",

  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1/*",
    "https://cdn.jsdelivr.net/*",
    "https://open.er-api.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options/options.html",

  "web_accessible_resources": [
    {
      "resources": ["data/currencies.data.js"],
      "matches": ["*://*.1688.com/*"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["*://*.1688.com/*"],
      "js": [
        "content/replace.js",
        "content/banner.js",
        "content/compose.js",
        "data/currencies.data.js",
        "content/price.js",
        "content/content.js",
        "content/pebble.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
